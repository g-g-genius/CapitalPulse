# backend environment variables
# Copy to .env and adjust as needed
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set true when the site is served over HTTPS.
COOKIE_SECURE=false

# Real-time SW2021 level-2 sector-flow collector
SECTOR_FLOW_ENABLED=true
SECTOR_FLOW_POLL_SECONDS=3
STOCK_FLOW_POLL_SECONDS=3
SECTOR_FLOW_DB_PATH=data/sector_flow_realtime.sqlite3
SECTOR_FLOW_RETENTION_DAYS=30

# Set these values to use the local MySQL Compose service. URL-encode reserved
# characters in MYSQL_PASSWORD when placing it inside DATABASE_URL.
# MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
# MYSQL_PASSWORD=replace-with-a-strong-app-password
# DATABASE_URL=mysql+pymysql://capitalpulse:replace-with-a-strong-app-password@127.0.0.1:3306/capitalpulse
